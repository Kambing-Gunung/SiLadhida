<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:SiLadhida.App.Models"
    x:Class="SiLadhida.App.Components.Dialogs.OrderItemDialog"
    x:CompileBindings="False">

    <StackPanel Margin="20" Spacing="12">

        <TextBlock
            Text="Pilih Produk"
            FontSize="22"
            FontWeight="Bold"/>

        <ScrollViewer MaxHeight="400">

            <DataGrid
                ItemsSource="{Binding Products}"
                AutoGenerateColumns="False"
                CanUserResizeColumns="False">

                <DataGrid.Columns>

                    <!-- CHECKBOX -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NAMA -->
                    <DataGridTextColumn
                        Header="Nama"
                        Binding="{Binding Nama}" />

                    <!-- STOCK -->
                    <DataGridTextColumn
                        Header="Stock"
                        Binding="{Binding Stock}" />

                    <!-- HARGA -->
                    <DataGridTextColumn
                        Header="Harga"
                        Binding="{Binding Harga, StringFormat='Rp {0:N0}'}" />

                </DataGrid.Columns>

            </DataGrid>

        </ScrollViewer>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="10"
                    Margin="0,10,0,0">

            <Button
                Content="Batal"
                Width="100"
                Click="Cancel_Click"/>

            <Button
                Content="Tambah ke Pesanan"
                HorizontalAlignment="Right"
                Click="Submit_Click"/>

        </StackPanel>

    </StackPanel>

</UserControl>