<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SiLadhida.App.Components.ConfirmDialog"
    WindowDecorations="None"
    Width="400"
    Height="220"
    WindowStartupLocation="CenterOwner">

    <Border Classes="card">

        <StackPanel Classes="section">

            <TextBlock
                Classes="heading"
                Text="Konfirmasi"/>

            <TextBlock
                x:Name="MessageText"
                Classes="subtitle"
                TextWrapping="Wrap"/>

            <StackPanel Classes="actions">

                <Button
                    Classes="secondary"
                    Content="Batal"
                    Click="Cancel_Click"/>

                <Button
                    Classes="danger"
                    Content="Ya"
                    Click="Confirm_Click"/>

            </StackPanel>

        </StackPanel>

    </Border>

</Window>