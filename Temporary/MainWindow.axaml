<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:SiLadhida.App.Services.App"
    xmlns:local="using:SiLadhida.App"
    x:Class="SiLadhida.App.MainWindow"
    x:DataType="services:NavigationService"
    Width="1200"
    Height="700"
    Title="SiLadhida">

    <Grid>

    <!-- CONTENT -->
    <ContentControl Content="{Binding CurrentViewModel}"/>

    <!-- LOADING OVERLAY -->
    <Border
        Background="#80000000"
        IsVisible="{Binding Source={x:Static local:App.Services.Loading}, Path=IsLoading}">

        <StackPanel
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">

            <ProgressBar
                IsIndeterminate="True"
                Width="200"
                Height="20"/>

            <TextBlock
                Text="Loading..."
                Foreground="White"
                HorizontalAlignment="Center"/>

        </StackPanel>

    </Border>

    <!-- TOAST -->
    <Border
        x:Name="ToastBorder"
        Background="#323232"
        CornerRadius="10"
        Padding="16"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="20"
        IsVisible="False">

        <TextBlock
            x:Name="ToastText"
            Foreground="White"/>

    </Border>

</Grid>

</Window>