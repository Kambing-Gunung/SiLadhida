<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:SiLadhida.App.Components"
    x:Class="SiLadhida.App.Views.DashboardLayout">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <components:Sidebar Grid.Column="0"/>

        <!-- Main Area -->
        <Grid
            Grid.Column="1"
            RowDefinitions="Auto,*">

            <!-- Topbar -->
            <components:Topbar
                Grid.Row="0"/>

            <!-- Dynamic Content -->
            <ContentControl
                x:Name="DashboardContent"
                Grid.Row="1"/>

        </Grid>

    </Grid>

</UserControl>