<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:SiLadhida.App.Components"
    x:Class="SiLadhida.App.MainWindow"
    Width="1200"
    Height="700"
    Title="SiLadhida">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->

        <components:Sidebar Grid.Column="0"/>

        <!-- CONTENT -->

        <ContentControl
            Name="MainContent"
            Grid.Column="1"/>

    </Grid>

</Window>