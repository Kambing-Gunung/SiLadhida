<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SiLadhida.App.MainWindow"
    Width="1200"
    Height="700"
    Title="SiLadhida">

    <Grid>

    <ContentControl
        x:Name="MainContent"/>

    <Border
        x:Name="ToastBorder"
        Background="#323232"
        CornerRadius="10"
        Padding="16"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Margin="20"
        IsVisible="False">

        <TextBlock
            x:Name="ToastText"
            Foreground="White"/>

    </Border>

</Grid>

</Window>