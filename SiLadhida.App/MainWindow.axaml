<Window
    x:Class="SiLadhida.App.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:app="clr-namespace:SiLadhida.App"
    Title="SiLadhida"
    Width="1200"
    Height="700"
    x:CompileBindings="False">

    <Grid>

        <!--  🔥 MAIN CONTENT  -->
        <ContentControl Content="{Binding CurrentView}" />

        <!--  🔥 TOAST  -->
        <Border
            Margin="20"
            Padding="16"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="#323232"
            CornerRadius="10"
            IsVisible="{Binding Source={x:Static app:App.Services}, Path=Notification.IsVisible}">

            <TextBlock Foreground="White" Text="{Binding Source={x:Static app:App.Services}, Path=Notification.Message}" />

        </Border>

        <!--  🔥 LOADING OVERLAY  -->
        <Border Background="#80000000" IsVisible="{Binding Source={x:Static app:App.Services}, Path=Loading.IsLoading}">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">

                <ProgressBar Width="200" IsIndeterminate="True" />

                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Text="{Binding Source={x:Static app:App.Services}, Path=Loading.Message}" />

            </StackPanel>

        </Border>

    </Grid>

</Window>
