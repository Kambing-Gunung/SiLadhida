<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiLadhida.App.ViewModels"
    x:Class="SiLadhida.App.Components.Topbar"
    x:DataType="vm:TopbarViewModel">


    <UserControl.DataContext>
        <vm:TopbarViewModel/>
    </UserControl.DataContext>

    <Border
        Background="#5D4037"
        BorderBrush="#E0C097"
        BorderThickness="0,0,0,1">

        <Grid Margin="20">

            <TextBlock
                Text="{Binding Title}"
                Foreground="White"
                FontSize="24"
                FontWeight="SemiBold"
                VerticalAlignment="Center"/>

        </Grid>

    </Border>

</UserControl>