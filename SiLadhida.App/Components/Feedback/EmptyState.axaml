<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SiLadhida.App.Components.Feedback"
    x:Class="SiLadhida.App.Components.Feedback.EmptyState">

    <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="12">

        <TextBlock
            Text="{Binding Icon,
                           RelativeSource={RelativeSource AncestorType=local:EmptyState}}"
            FontSize="48"
            HorizontalAlignment="Center"/>

        <TextBlock
            Classes="heading"
            Text="{Binding Title,
                           RelativeSource={RelativeSource AncestorType=local:EmptyState}}"
            HorizontalAlignment="Center"/>

        <TextBlock
            Classes="subtitle"
            Text="{Binding Description,
                           RelativeSource={RelativeSource AncestorType=local:EmptyState}}"
            TextAlignment="Center"
            MaxWidth="300"/>

    </StackPanel>

</UserControl>