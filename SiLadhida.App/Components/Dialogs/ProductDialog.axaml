<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:SiLadhida.App.Models"
    x:Class="SiLadhida.App.Components.Dialogs.ProductDialog"
    x:DataType="models:ProductFormModel">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="Nama Produk"/>

        <TextBox
        Text="{Binding Nama}"
        PlaceholderText="Masukkan nama produk"/>

        <TextBlock Text="Harga"/>

        <TextBox
        Text="{Binding Harga}"
        PlaceholderText="Masukkan harga"/>

        <TextBlock Text="Stock"/>

        <TextBox
        Text="{Binding Stock}"
        PlaceholderText="Masukkan stock"/>

        <TextBlock
        x:Name="ErrorText"
        Foreground="Red"
        IsVisible="False"/>

        <Button
        Content="Simpan"
        HorizontalAlignment="Right"
        Width="100"
        Click="Save_Click"/>

        <Button
        Content="Batal"
        HorizontalAlignment="Right"
        Width="100"
        Margin="0,10,0,0"
        Click="Cancel_Click"/>

    </StackPanel>

</UserControl>