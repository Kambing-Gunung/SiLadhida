<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SiLadhida.App.Components.Shell.Sidebar">

    <Border
        Width="240"
        Background="{DynamicResource CardBackgroundBrush}">

        <Grid
            RowDefinitions="Auto,*,Auto"
            Margin="20">

            <!-- Header -->
            <StackPanel
                Grid.Row="0"
                Margin="20"
                Classes="section">

                <TextBlock
                    Classes="heading"
                    Text="☕ SiLadhida"/>

                <TextBlock
                    Classes="caption"
                    Text="Sistem Informasi Kedai"/>

            </StackPanel>

            <!-- Menu -->
            <StackPanel
                Grid.Row="1"
                Margin="0,24,0,0"
                Classes="section">

                <Button
                    x:Name="DashboardButton"
                    Classes="nav-button"
                    Content="🏠 Dashboard"
                    Click="Dashboard_Click"/>

                <Button
                    x:Name="ProdukButton"
                    Classes="nav-button"
                    Content="📦 Produk"
                    Click="Product_Click"/>

                <Button
                    x:Name="PesananButton"
                    Classes="nav-button"
                    Content="🛒 Pesanan"
                    Click="Order_Click"/>

                <Button
                    x:Name="TransaksiButton"
                    Classes="nav-button"
                    Content="💳 Transaksi"
                    Click="Transaction_Click"/>

            </StackPanel>

            <!-- Footer -->
            <Border
                Grid.Row="2"
                Padding="20">

                <Button
                    x:Name="LogoutButton"
                    Classes="danger"
                    Content="🚪 Logout"
                    Click="Logout_Click"/>
            </Border>
        </Grid>

    </Border>

</UserControl>