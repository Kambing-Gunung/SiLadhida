<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SiLadhida.App.Components.Inputs"
    x:Class="SiLadhida.App.Components.Inputs.SearchBox">

    <Grid ColumnDefinitions="Auto,*"
          VerticalAlignment="Center">

        <!-- Icon -->
        <TextBlock
            Text="🔍"
            FontSize="13"
            VerticalAlignment="Center"
            Margin="10,0,6,0"/>

        <!-- Input -->
        <TextBox
            Grid.Column="1"
            Height="36"
            FontSize="14"
            Padding="10,0"
            CornerRadius="10"
            Text="{Binding Text,
            RelativeSource={RelativeSource AncestorType=local:SearchBox},
            UpdateSourceTrigger=PropertyChanged}"
            PlaceholderText="{Binding Placeholder,
            RelativeSource={RelativeSource AncestorType=local:SearchBox}}"/>

    </Grid>

</UserControl>