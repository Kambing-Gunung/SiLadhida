<UserControl
    x:Class="SiLadhida.App.Features.Order.OrderDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:SiLadhida.App.Features.Order"
    x:Name="Root"
    x:DataType="model:OrderDialogViewModel">

    <ScrollViewer>

        <StackPanel Classes="section" Spacing="12">

            <TextBlock Classes="heading" Text="Kelola Pesanan" />

            <TextBlock Classes="label" Text="Nama Pemesan" />
            <TextBox IsReadOnly="True" Text="{Binding NamaPemesan}" />

            <TextBlock Classes="label" Text="Status" />
            <TextBlock Text="{Binding Status}" />

            <TextBlock Classes="label" Text="Total" />
            <TextBlock Classes="heading" Text="{Binding TotalHarga, StringFormat='Rp {0:N0}'}" />

            <TextBlock Classes="label" Text="Items" />

            <ScrollViewer
                MaxHeight="300"
                BorderBrush="#DDDDDD"
                BorderThickness="1"
                CornerRadius="20">
                <ItemsControl ItemsSource="{Binding Items}">

                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:OrderItem">

                            <Border Classes="card">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8">

                                    <StackPanel>
                                        <TextBlock Text="{Binding NamaProduk}" />
                                        <TextBlock Classes="subtitle" Text="{Binding SubTotal, StringFormat='Rp {0:N0}'}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Width="30"
                                        Command="{Binding DataContext.DecreaseQtyCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="-" />

                                    <TextBlock
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontWeight="Bold"
                                        Text="{Binding Quantity}" />

                                    <Button
                                        Grid.Column="3"
                                        Width="30"
                                        Command="{Binding DataContext.IncreaseQtyCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="+" />

                                    <Button
                                        Grid.Column="4"
                                        Width="30"
                                        Classes="danger"
                                        Command="{Binding DataContext.RemoveItemCommand, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Content="🗑" />

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>


                </ItemsControl>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" Spacing="10">

                <Button
                    Classes="primary"
                    Command="{Binding AddItemCommand}"
                    Content="+ Tambah Item"
                    IsCancel="False"
                    IsDefault="False" />

                <Button
                    Classes="secondary"
                    Command="{Binding CloseCommand}"
                    Content="Tutup"
                    IsCancel="False"
                    IsDefault="False" />

            </StackPanel>

        </StackPanel>

    </ScrollViewer>

</UserControl>
