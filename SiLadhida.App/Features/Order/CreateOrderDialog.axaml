<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SiLadhida.App.Features.Order"
    x:Class="SiLadhida.App.Features.Order.CreateOrderDialog"
    Title="Buat Pesanan Baru"
    Width="450" Height="550"
    WindowStartupLocation="CenterOwner"
    CanResize="False"
    x:CompileBindings="False">

    <Grid Margin="20" RowDefinitions="Auto,*,Auto">
        
        <StackPanel Grid.Row="0" Spacing="15">
            <TextBlock Classes="heading" Text="Informasi Pesanan" FontSize="18" FontWeight="Bold"/>
            
            <StackPanel Spacing="5">
                <TextBlock Text="Nama Pemesan:" FontWeight="SemiBold"/>
                <TextBox Text="{Binding NewOrderName}" PlaceholderText="Masukkan nama pelanggan..." />
            </StackPanel>

            <Separator Background="#EEEEEE" Height="1" Margin="0,5"/>
            <TextBlock Text="Pilih Produk &amp; Jumlah" FontSize="14" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,10" BorderBrush="#DDDDDD" BorderThickness="1" CornerRadius="4">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding ProductList}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="10,8">
                                <Grid ColumnDefinitions="*, Auto, Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Content="{Binding ProductName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Harga, StringFormat='Rp {0:N0}'}" VerticalAlignment="Center" Margin="10,0,15,0" Foreground="Gray"/>
                                    <NumericUpDown Grid.Column="2" Value="{Binding Quantity}" Minimum="1" IsEnabled="{Binding IsSelected}" Width="100" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
            <Button Content="Batal" Command="{Binding CloseDialogCommand}" Width="100" HorizontalContentAlignment="Center"/>
            <Button Classes="primary" Content="Simpan &amp; Buat Pesanan" Command="{Binding SubmitOrderCommand}" Width="180" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>