<UserControl
    x:Class="SiLadhida.App.Features.Order.OrderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:inputs="using:SiLadhida.App.Components.Inputs"
    xmlns:model="using:SiLadhida.App.Features.Order"
    xmlns:vm="using:SiLadhida.App.Features.Order"
    x:Name="Root"
    x:DataType="vm:OrderViewModel">

    <Grid Classes="page" RowDefinitions="Auto,Auto,Auto,*">

        <ScrollViewer>

            <StackPanel Classes="section" Spacing="12">

                <!--  🔥 TITLE  -->
                <TextBlock
                    Grid.Row="0"
                    Classes="heading"
                    Text="Pesanan" />

                <!--  🔥 TOOLBAR  -->
                <Grid
                    Grid.Row="1"
                    ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="12">

                    <inputs:SearchBox
                        IsEnabled="{Binding DataContext.IsLoading, ElementName=Root, Converter={StaticResource InverseBoolConverter}}"
                        Placeholder="Cari produk..."
                        Text="{Binding SearchText, Mode=TwoWay}" />

                    <TextBox
                        Grid.Column="1"
                        Width="200"
                        PlaceholderText="Nama Pemesan"
                        Text="{Binding NamaPemesan}" />

                    <Button
                        Grid.Column="2"
                        Classes="primary"
                        Command="{Binding CreateOrderCommand}"
                        Content="+ Tambah Pesanan" />

                </Grid>

                <!--  🔥 LOADING  -->
                <TextBlock
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsLoading}"
                    Text="Loading pesanan..." />

                <!--  🔥 LIST  -->
                <DataGrid
                    Grid.Row="3"
                    AutoGenerateColumns="False"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding ActiveOrders}"
                    RowHeight="50">

                    <DataGrid.Columns>

                        <!--  🔥 Nama  -->
                        <DataGridTextColumn Binding="{Binding NamaPemesan}" Header="Nama Pemesan" />

                        <!--  🔥 Status  -->
                        <DataGridTextColumn Binding="{Binding StatusSekarang}" Header="Status" />

                        <!--  🔥 Total  -->
                        <DataGridTextColumn Binding="{Binding TotalHarga, StringFormat='Rp {0:N0}'}" Header="Total" />

                        <!--  🔥 Action  -->
                        <DataGridTemplateColumn Header="Aksi">

                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate x:DataType="model:Order">

                                    <StackPanel Orientation="Horizontal" Spacing="6">

                                        <!--  ⚙  -->
                                        <Button
                                            Classes="icon-button"
                                            Command="{Binding DataContext.OpenManageDialogCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="⚙"
                                            IsEnabled="{Binding CanManage}" />

                                        <!--  💳  -->
                                        <Button
                                            Classes="icon-button success"
                                            Command="{Binding DataContext.PayOrderCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="💳"
                                            IsEnabled="{Binding CanPay}" />

                                        <!--  ✖  -->
                                        <Button
                                            Classes="icon-button danger"
                                            Command="{Binding DataContext.CancelOrderCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="✖"
                                            IsEnabled="{Binding CanCancel}" />

                                        <!--  ✔  -->
                                        <Button
                                            Classes="icon-button"
                                            Command="{Binding DataContext.CompleteOrderCommand, ElementName=Root}"
                                            CommandParameter="{Binding}"
                                            Content="✔"
                                            IsEnabled="{Binding CanComplete}" />

                                    </StackPanel>

                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                    </DataGrid.Columns>

                </DataGrid>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>
