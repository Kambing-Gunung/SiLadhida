<UserControl
    x:Class="SiLadhida.App.Features.Order.OrderView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:model="using:SiLadhida.App.Features.Order"
    xmlns:vm="using:SiLadhida.App.Features.Order"
    x:DataType="vm:OrderViewModel">

    <Grid Classes="page">
        <ScrollViewer>
            <StackPanel Classes="section" Spacing="15">

                <TextBlock Classes="heading" Text="Pesanan" />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button
                        Classes="primary"
                        Command="{Binding OpenCreateOrderDialogCommand}"
                        Content="+ Buat Pesanan Baru" />
                </StackPanel>

                <TextBlock
                    Margin="0,10"
                    HorizontalAlignment="Center"
                    IsVisible="{Binding IsLoading}"
                    Text="Loading orders..." />

                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Pesanan Aktif" />
                <ItemsControl ItemsSource="{Binding ActiveOrders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:Order">
                            <Border Margin="8" Classes="card">
                                <StackPanel Classes="section">
                                    <TextBlock Classes="heading" Text="{Binding NamaPemesan}" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding StatusSekarang}" Foreground="{Binding StatusSekarang, Converter={StaticResource StatusToBrushConverter}}"/>
                                    <TextBlock Classes="subtitle" Text="{Binding TotalHarga, StringFormat='Total: Rp {0:N0}'}" />

                                    <StackPanel
                                        Margin="0,10,0,0"
                                        Orientation="Horizontal"
                                        Spacing="8">
                                        <Button
                                            Classes="icon-button"
                                            Click="Manage_Click"
                                            Content="⚙"
                                            IsEnabled="{Binding CanManage}"
                                            Tag="{Binding}" />
                                        <Button
                                            Classes="icon-button success"
                                            Command="{Binding $parent[UserControl].((vm:OrderViewModel)DataContext).PayOrderCommand}"
                                            CommandParameter="{Binding}"
                                            Content="💳"
                                            IsEnabled="{Binding CanPay}" />
                                        <Button
                                            Classes="icon-button danger"
                                            Command="{Binding $parent[UserControl].((vm:OrderViewModel)DataContext).CancelOrderCommand}"
                                            CommandParameter="{Binding}"
                                            Content="✖"
                                            IsEnabled="{Binding CanCancel}"
                                            ToolTip.Tip="Batalkan Pesanan" />
                                        <Button
                                            Command="{Binding $parent[UserControl].((vm:OrderViewModel)DataContext).CompleteOrderCommand}"
                                            CommandParameter="{Binding}"
                                            Content="Selesai"
                                            IsEnabled="{Binding CanComplete}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Separator
                    Height="1"
                    Margin="0,15"
                    Background="#DDDDDD" />

                <TextBlock
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Riwayat Pesanan (Selesai)" />
                <ItemsControl ItemsSource="{Binding CompletedOrders}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:Order">

                            <Border
                                Margin="8"
                                Background="#F0FFF0"
                                BorderBrush="#A5D6A7"
                                BorderThickness="2"
                                Classes="card"
                                CornerRadius="6">
                                <StackPanel Classes="section">

                                    <TextBlock
                                        Classes="heading"
                                        FontSize="18"
                                        Foreground="#1B5E20"
                                        Text="{Binding NamaPemesan}" />

                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontWeight="ExtraBold"
                                        Foreground="#2E7D32"
                                        Text="{Binding StatusSekarang}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        Classes="subtitle"
                                        Foreground="#555555"
                                        Text="{Binding TotalHarga, StringFormat='Total: Rp {0:N0}'}" />

                                </StackPanel>
                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
