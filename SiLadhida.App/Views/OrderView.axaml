<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiLadhida.App.ViewModels"
    xmlns:model="using:SiLadhida.App.Models"
    xmlns:components="using:SiLadhida.App.Components"
    x:Class="SiLadhida.App.Views.OrderView"
    x:DataType="vm:OrderViewModel">

    <UserControl.DataContext>
        <vm:OrderViewModel/>
    </UserControl.DataContext>

    <!-- CONTENT -->
    <Grid Grid.Column="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- TOPBAR -->
        <components:Topbar Grid.Row="0">
            <components:Topbar.DataContext>
                <vm:TopbarViewModel Title="Daftar Pesanan"/>
            </components:Topbar.DataContext>
        </components:Topbar>

        <!-- MAIN CONTENT -->
        <ScrollViewer Grid.Row="1">

            <StackPanel Margin="20">

                <!-- LOADING -->
                <TextBlock
                    Text="Loading orders..."
                    IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,10"/>

                <!-- BUTTON -->
                <Button
                    Content="+ Tambah Pesanan"
                    Width="180"
                    Height="40"
                    Margin="0,0,0,20"
                    Background="#6D4C41"
                    Foreground="White"
                    Click="AddOrder_Click"/>

                <!-- ORDER LIST -->
                <ItemsControl ItemsSource="{Binding Orders}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate x:DataType="model:Order">

                            <Border
                                Background="#3E2723"
                                CornerRadius="10"
                                Padding="15"
                                Margin="0,0,0,10">

                                <StackPanel Spacing="10">

                                    <!-- ORDER NAME -->
                                    <TextBlock
                                        Text="{Binding NamaPemesan}"
                                        FontSize="18"
                                        FontWeight="Bold"
                                        Foreground="White"/>

                                    <!-- ORDER STATUS -->
                                    <TextBlock
                                        Text="{Binding StatusSekarang}"
                                        Foreground="#D7CCC8"/>

                                    <!-- ORDER TOTAL -->
                                    <TextBlock
                                        Text="{Binding TotalHarga, StringFormat='Total: Rp {0:N0}'}"
                                        Foreground="#D7CCC8"/>

                                    <!-- ACTIONS -->
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="10">

                                        <Button
                                            Content="Edit"
                                            Background="#6D4C41"/>
                                            <!-- Command="{Binding $parent[UserControl].DataContext.UpdateOrderCommand}"
                                            CommandParameter="{Binding}"/> -->

                                        <Button
                                            Content="Delete"
                                            Background="#B71C1C"
                                            Foreground="White"
                                            Click="Delete_Click"
                                            Tag="{Binding}"/>

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>