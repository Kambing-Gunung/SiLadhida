<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiLadhida.App.ViewModels"
    xmlns:model="using:SiLadhida.App.Models"
    x:Class="SiLadhida.App.Views.OrderView"
    x:DataType="vm:OrderViewModel">

    <UserControl.DataContext>
        <vm:OrderViewModel/>
    </UserControl.DataContext>

    <Grid Classes="page">

        <ScrollViewer>

            <StackPanel Classes="section">

                <!-- TITLE -->
                <TextBlock
                    Classes="heading"
                    Text="Pesanan"/>

                <!-- TOOLBAR -->
                <StackPanel Orientation="Horizontal"
                            Spacing="10">

                    <TextBox
                        Width="250"
                        PlaceholderText="Nama Pemesan"
                        Text="{Binding NamaPemesan}" />

                    <Button
                        Classes="primary"
                        Content="+ Tambah Pesanan"
                        Command="{Binding CreateOrderCommand}" />

                </StackPanel>

                <!-- LOADING -->
                <TextBlock
                    Text="Loading orders..."
                    IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Center"/>

                <!-- ORDER LIST -->
                <ItemsControl ItemsSource="{Binding ActiveOrders}">

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>

                        <DataTemplate x:DataType="model:Order">

                            <Border Classes="card" Margin="8">

                                <StackPanel Classes="section">

                                    <!-- Nama -->
                                    <TextBlock
                                        Classes="heading"
                                        Text="{Binding NamaPemesan}"/>

                                    <!-- Status -->
                                    <TextBlock
                                        Text="{Binding StatusSekarang}"
                                        Foreground="{Binding StatusClass}"
                                        FontWeight="SemiBold"/>

                                    <!-- Total -->
                                    <TextBlock
                                        Classes="subtitle"
                                        Text="{Binding TotalHarga, StringFormat='Total: Rp {0:N0}'}"/>

                                    <!-- ACTION -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">

                                        <Button
                                            Classes="icon-button"
                                            Content="⚙"
                                            Click="Manage_Click"
                                            Tag="{Binding}"
                                            IsEnabled="{Binding CanManage}" />

                                        <Button
                                            Classes="icon-button success"
                                            Content="💳"
                                            Command="{Binding $parent[UserControl].DataContext.PayOrderCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanPay}" />

                                        <Button
                                            Classes="icon-button danger"
                                            Content="✖"
                                            Command="{Binding $parent[UserControl].DataContext.CancelOrderCommand}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanCancel}" />

                                        <Button
                                            Content="Selesai"
                                            Command="{Binding $parent[UserControl].DataContext.CompleteOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding CanComplete}" />

                                    </StackPanel>

                                </StackPanel>

                            </Border>

                        </DataTemplate>

                    </ItemsControl.ItemTemplate>

                </ItemsControl>

            </StackPanel>

        </ScrollViewer>

    </Grid>

</UserControl>