<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="SiLadhida.App.Views.ConfirmDialog"
    Width="350"
    Height="180"
    Title="Konfirmasi">

    <StackPanel
        Margin="20"
        Spacing="20">

        <TextBlock
            x:Name="MessageText"
            TextWrapping="Wrap"
            FontSize="16"/>

        <StackPanel
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="10">

            <Button
                Content="Batal"
                Width="100"
                Click="Cancel_Click"/>

            <Button
                Content="Ya"
                Width="100"
                Background="#8D6E63"
                Foreground="White"
                Click="Confirm_Click"/>

        </StackPanel>

    </StackPanel>

</Window>