<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:SiLadhida.App.ViewModels"
    x:Class="SiLadhida.App.Views.LoginView"
    x:DataType="vm:LoginViewModel">

    <Design.DataContext>
        <vm:LoginViewModel/>
    </Design.DataContext>

    <Grid
        Background="{DynamicResource PageBackgroundBrush}">

        <Border
            Width="400"
            Classes="card"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

            <StackPanel Classes="section">

                <TextBlock
                    Text="☕"
                    FontSize="40"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Classes="title"
                    Text="SiLadhida"
                    HorizontalAlignment="Center"/>

                <TextBlock
                    Classes="subtitle"
                    Text="Sistem Informasi Kedai"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,12"/>

                <StackPanel Classes="form-field">

                    <TextBlock
                        Classes="label"
                        Text="Username"/>

                    <TextBox
                        x:Name="UsernameTextBox"
                        Text="{Binding Username}"
                        Watermark="Masukkan username"
                        KeyDown="OnLoginKeyDown"/>

                </StackPanel>

                <StackPanel
                    Classes="form-field">

                    <TextBlock
                        Classes="label"
                        Text="Password"/>

                    <Grid ColumnDefinitions="*,8,Auto">

                        <Grid Grid.Column="0">

                            <TextBox
                                Text="{Binding Password}"
                                PasswordChar="●"
                                IsVisible="{Binding IsPasswordVisible,
                                Converter={StaticResource BoolNegationConverter}}"
                                KeyDown="OnLoginKeyDown"/>

                            <TextBox
                                Text="{Binding Password}"
                                IsVisible="{Binding IsPasswordVisible}"
                                KeyDown="OnLoginKeyDown"/>

                        </Grid>

                        <Button
                            Grid.Column="2"
                            Classes="icon-button"
                            Content="👁"
                            Command="{Binding TogglePasswordCommand}"/>

                    </Grid>

                </StackPanel>

                <Button
                    Classes="primary"
                    Content="Login"
                    Command="{Binding LoginCommand}"
                    HorizontalAlignment="Center"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource BoolNegationConverter}}"/>

                <TextBlock
                    Classes="error"
                    Text="{Binding Message}"
                    TextWrapping="Wrap"/>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>